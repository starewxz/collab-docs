# Staging overlay - NOT a standalone file. Copy .env.example to .env first,
# then apply these overrides on top of it. Only values that actually differ
# from .env.example are listed here; everything else (Postgres/Redis/MinIO
# credentials, JWT/webhook secrets, port overrides, ...) is documented once,
# in .env.example, and should be given real staging-specific values there -
# never reused from development or production.
#
# See the "Environments" section in README.md for what NODE_ENV=staging
# actually changes at runtime (AppConfigService.isProductionLike): secure
# cookies, hidden internal error detail, structured JSON logs, and no
# dev-token exposure in invitation responses - the same security posture as
# production, on infrastructure that is otherwise separate from it.

# ===== Application =====
NODE_ENV=staging

# Real staging hostnames, not localhost - adjust to your actual deployment.
FRONTEND_URL=https://staging.example.com
BACKEND_URL=https://staging-api.example.com
# Only needed if the frontend/backend are on different subdomains.
COOKIE_DOMAIN=.example.com

# Server-to-server addresses (Docker DNS names, or your staging network's
# internal service names) - browser-unreachable, used for revalidation and
# server-side fetches. Only needed if they differ from FRONTEND_URL/
# BACKEND_URL, e.g. behind a private network or a different internal port.
# FRONTEND_INTERNAL_URL=http://frontend:3000
# BACKEND_INTERNAL_URL=http://backend:4000

# Generate distinct values for staging - never reuse a development or
# production secret here: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
REVALIDATE_SECRET=
BILLING_WEBHOOK_SECRET=

# ===== Frontend =====
# Must be the real staging API origin - inlined into the browser bundle at
# build time.
NEXT_PUBLIC_API_URL=https://staging-api.example.com
