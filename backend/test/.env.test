NODE_ENV=test
PORT=4000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

POSTGRES_HOST=localhost
# Matches the repository Compose stack's documented default host port
# (README: "the repository Compose defaults are PostgreSQL 5434") - not
# Postgres's own default 5432, which the Compose file intentionally avoids
# to keep from colliding with a locally-installed Postgres. CI overrides
# this directly in its own job env (its service container maps 5432:5432),
# so this only affects local `npm run test:e2e` runs against `docker
# compose up`.
POSTGRES_PORT=5434
POSTGRES_USER=collab_docs
POSTGRES_PASSWORD=collab_docs
POSTGRES_DB=collab_docs

REDIS_HOST=localhost
REDIS_PORT=6379

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=collab-docs
MINIO_USE_SSL=false

JWT_ACCESS_SECRET=test-access-secret-please-do-not-use-in-prod-0000
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_SECRET=test-refresh-secret-please-do-not-use-in-prod-000
JWT_REFRESH_EXPIRES_IN_SECONDS=2592000

# The register bucket's production default (20/60s) is too tight for a
# single e2e spec file registering many accounts in one process within the
# same window (collaboration.e2e-spec.ts alone needs 21) - raise it for the
# test process only, production limit is untouched.
THROTTLE_REGISTER_LIMIT=200

# Short durability-flush window so e2e tests don't need to wait ~3s (see
# CollaborationPersistenceService).
COLLAB_PERSIST_INTERVAL_MS=200

BILLING_WEBHOOK_SECRET=test-billing-webhook-secret-0000
