# Copy to .env and adjust as needed. Values below assume `docker compose up`,
# where services reach each other by Docker DNS name (postgres/redis/minio).
# For running the backend/frontend locally outside Docker, override the
# *_HOST / *_ENDPOINT / *_INTERNAL_URL values to localhost — see README.

# ===== Application =====
NODE_ENV=development
PORT=4000
# Must match wherever the browser actually loads the frontend from -
# defaults to FRONTEND_HOST_PORT below (3001) to avoid colliding with
# other local projects on 3000.
FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:4000
# Leave unset for local dev (localhost is shared host-only across ports).
# Set to a shared parent domain (e.g. ".example.com") in production if the
# frontend/backend live on different subdomains.
COOKIE_DOMAIN=
# Optional: Docker-DNS-reachable frontend address for the backend's
# server-to-server revalidation call (Stage 7 publishing). Defaults to
# FRONTEND_URL when unset; the docker-compose backend service already
# overrides this to http://frontend:3000, so this is only relevant for
# custom deployments.
# FRONTEND_INTERNAL_URL=http://frontend:3000
# Shared secret between backend and frontend for the on-demand ISR
# revalidation call - generate with: openssl rand -hex 32
REVALIDATE_SECRET=

# ===== Postgres =====
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=collab_docs
POSTGRES_PASSWORD=collab_docs
POSTGRES_DB=collab_docs

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379

# ===== MinIO =====
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=collab-docs
MINIO_USE_SSL=false
# Optional: host/port used only when signing presigned attachment URLs,
# which go to the browser and can't resolve the internal "minio" hostname
# above. Defaults to MINIO_ENDPOINT/MINIO_PORT/MINIO_USE_SSL when unset -
# the docker-compose backend service already sets these to the
# host-reachable address, so this is only relevant for custom deployments.
# MINIO_PUBLIC_ENDPOINT=localhost
# MINIO_PUBLIC_PORT=9000
# MINIO_PUBLIC_USE_SSL=false

# ===== JWT =====
# Generate real secrets with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN_SECONDS=2592000

# ===== Billing (Stage 8) =====
# Shared secret checked against the `x-billing-webhook-secret` header on
# POST /billing/webhook. Generate with: openssl rand -hex 32
BILLING_WEBHOOK_SECRET=

# ===== Host port overrides (optional) =====
# Only change which port each service is published on *outside* Docker;
# containers still talk to each other over the default ports above.
# POSTGRES_HOST_PORT=5434
# REDIS_HOST_PORT=6380
# MINIO_HOST_PORT=9000
# MINIO_CONSOLE_HOST_PORT=9001
# BACKEND_HOST_PORT=4000
# FRONTEND_HOST_PORT=3001

# ===== Frontend =====
# Server-side only (Server Components -> backend container, Docker DNS name)
BACKEND_INTERNAL_URL=http://backend:4000
# Inlined into the browser bundle at build time - never put secrets here
NEXT_PUBLIC_API_URL=http://localhost:4000
