# Copy to .env and adjust as needed. Values below assume `docker compose up`,
# where services reach each other by Docker DNS name (postgres/redis/minio).
# For running the backend/frontend locally outside Docker, override the
# *_HOST / *_ENDPOINT / *_INTERNAL_URL values to localhost — see README.

# ===== Application =====
NODE_ENV=development
PORT=4000
# Must match wherever the browser actually loads the frontend from -
# defaults to FRONTEND_HOST_PORT below (3001) to avoid colliding with
# other local projects on 3000.
FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:4000
# Leave unset for local dev (localhost is shared host-only across ports).
# Set to a shared parent domain (e.g. ".example.com") in production if the
# frontend/backend live on different subdomains.
COOKIE_DOMAIN=

# ===== Postgres =====
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=collab_docs
POSTGRES_PASSWORD=collab_docs
POSTGRES_DB=collab_docs

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379

# ===== MinIO =====
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=collab-docs
MINIO_USE_SSL=false

# ===== JWT =====
# Generate real secrets with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN_SECONDS=2592000

# ===== Host port overrides (optional) =====
# Only change which port each service is published on *outside* Docker;
# containers still talk to each other over the default ports above.
# POSTGRES_HOST_PORT=5434
# REDIS_HOST_PORT=6380
# MINIO_HOST_PORT=9000
# MINIO_CONSOLE_HOST_PORT=9001
# BACKEND_HOST_PORT=4000
# FRONTEND_HOST_PORT=3001

# ===== Frontend =====
# Server-side only (Server Components -> backend container, Docker DNS name)
BACKEND_INTERNAL_URL=http://backend:4000
# Inlined into the browser bundle at build time - never put secrets here
NEXT_PUBLIC_API_URL=http://localhost:4000
